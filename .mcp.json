{
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "codebase-memory-mcp"
      ]
    },
    "file-browser": {
      "type": "stdio",
      "command": "node",
      "args": [
        "mcp/server.mjs"
      ],
      "env": {
        "FILE_BROWSER_MAX_LINES": "${FILE_BROWSER_MAX_LINES:-200}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp/oauth"
    }
  }
}